<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicPlayerApp.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="مشغل الموسيقى" 
               FontSize="24" 
               HorizontalOptions="Center"/>

        <Button x:Name="PickFileButton"
                Text="اختر ملف موسيقى"
                Clicked="OnPickFileClicked"/>

        <Label x:Name="FileNameLabel" 
               Text="لم يتم اختيار ملف"
               HorizontalOptions="Center"/>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Button x:Name="PlayButton" Text="Play" Clicked="OnPlayClicked"/>
            <Button x:Name="PauseButton" Text="Pause" Clicked="OnPauseClicked"/>
            <Button x:Name="StopButton" Text="Stop" Clicked="OnStopClicked"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
